# Port et hôte d'écoute Next.js
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=development

# URL interne du backend API (utilisée par le serveur Next.js en SSR et Server Actions)
API_URL=http://localhost:3001

# --- Variables inlinées lors du build (NEXT_PUBLIC_*) ---
# 'false' pour activer les appels API réels vers le backend NestJS, 'true' pour les fixtures
NEXT_PUBLIC_API_MOCK=false

# URL publique du backend appelée directement depuis le navigateur client si nécessaire
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Connexion Google (facultative) ---
# Sans ces deux valeurs, le bouton « Continuer avec Google » n'est pas proposé :
# le site démarre et fonctionne normalement.
# Obtenues dans Google Cloud Console → Identifiants → ID client OAuth (Web).
# À renseigner dans Dokploy (onglet Environment), JAMAIS ici : ce fichier est
# versionné, et GitHub refuse un envoi qui contient un secret.
# Le secret ne doit JAMAIS être préfixé NEXT_PUBLIC_ : il partirait au navigateur.
# URI de redirection à déclarer dans la console, au caractère près :
#   https://teranga-way.com/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret partagé entre le site et l'API pour POST /comptes/oauth/google.
# Facultatif mais recommandé : cette route ouvre une session pour l'adresse
# qu'on lui donne, et l'isolement du réseau interne est sa seule autre barrière.
# La même valeur doit être posée sur le service api.
SECRET_OAUTH_INTERNE=
\n
# --- MESURE D'AUDIENCE (UMAMI) ---
# Secret de signature des sessions du tableau de bord. Obligatoire.
#   openssl rand -hex 32
UMAMI_APP_SECRET=

# Nom du FICHIER de script servi aux visiteurs — pas un domaine.
# « mesure » donne https://stats.exemple.com/mesure.js ; « script.js », le nom
# par défaut d'Umami, est reconnu par les bloqueurs de publicité, qui mangent
# 15 à 30 % du comptage. La même valeur est lue par le conteneur Umami et par
# le site : une seule variable, pour qu'elles ne puissent pas diverger.
UMAMI_TRACKER_SCRIPT_NAME=mesure

# Adresse publique du tableau de bord Umami, et identifiant du site qu'il
# affiche une fois créé dans son interface. Les deux sont lus par le serveur
# Next à chaque requête : sans eux, aucun script de mesure n'est posé.
UMAMI_URL=
UMAMI_SITE_ID=
