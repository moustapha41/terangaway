# Port d'écoute de l'API. Le site tourne sur 3000.
PORT=3001

# Origines autorisées à appeler l'API, séparées par des virgules.
ORIGINES_AUTORISEES=http://localhost:3000

# Durée de validité d'un jeton de réponse partenaire, en minutes (PAR-11).
DUREE_JETON_MINUTES=120

# Délai accordé au partenaire pour répondre à une demande, en minutes.
DELAI_REPONSE_MINUTES=120

# Préavis minimal pour une prise en charge, en heures (§B.3).
DELAI_MINIMUM_HEURES=2
