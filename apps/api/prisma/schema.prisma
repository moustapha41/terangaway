datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

enum RoleCompte {
  VISITEUR
  PRESTATAIRE
  ADMINISTRATEUR
}

enum TypeCompte {
  LOGEMENT
  TRANSPORT
  LES_DEUX
  VISITEUR
}

enum StatutDemandeDb {
  envoyee
  acceptee
  confirmee
  terminee
  refusee
  expiree
  annulee
}

enum GenreOffreDb {
  logement
  trajet
  location
  taxi
  service
}

model Account {
  id             String         @id @default(cuid())
  email          String?        @unique
  telephone      String?        @unique
  nom            String?
  role           RoleCompte     @default(VISITEUR)
  typeCompte     TypeCompte     @default(VISITEUR)
  estVerifie     Boolean        @default(false)
  verifieLe      DateTime?

  /// Empreinte scrypt du mot de passe : `scrypt$N$r$p$sel$empreinte`.
  ///
  /// Nullable, et c'est le point : les comptes créés avant l'inscription par
  /// mot de passe — ou nés d'une simple demande de code — n'en ont pas, et
  /// continuent de se connecter par code à usage unique. `NULL` veut dire
  /// « ce compte n'a pas de mot de passe », jamais « mot de passe vide ».
  motDePasseHash String?

  /// Ce mot de passe a-t-il été engendré par nous et envoyé par e-mail ?
  ///
  /// Une demande envoyée sans compte ouvre un compte et expédie des
  /// identifiants à l'adresse saisie. Tant que personne ne s'en est servi,
  /// l'adresse n'est pas prouvée — d'où `estVerifie: false` — mais le mot de
  /// passe doit tout de même ouvrir la porte, sans quoi l'e-mail ne servirait
  /// à rien. Ce drapeau est exactement cette exception, et il retombe à la
  /// première connexion : la boîte a alors été relevée, l'adresse est prouvée.
  motDePasseProvisoire Boolean @default(false)
  charteSigneeLe DateTime?
  creeLe         DateTime       @default(now())
  misAJourLe     DateTime       @updatedAt

  sessions       Session[]
  otpChallenges  OtpChallenge[]
  demandes       Demand[]                @relation("DemandesVisiteur")
  demandesRecues Demand[]                @relation("DemandesPrestataire")
  jetonsReponse  ProviderResponseToken[]

  @@index([role])
  @@map("accounts")
}

model OtpChallenge {
  id          String    @id @default(cuid())
  destination String
  ipAddress   String?
  finalite    String    @default("connexion")
  codeHash    String
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  accountId   String?
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creeLe      DateTime  @default(now())

  @@index([destination, creeLe])
  @@index([ipAddress, creeLe])
  @@map("otp_challenges")
}

model Session {
  id        String    @id @default(cuid())
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  creeLe    DateTime  @default(now())

  @@index([accountId])
  @@index([tokenHash])
  @@map("sessions")
}

model Demand {
  id                  String          @id @default(cuid())
  reference           String          @unique
  visiteurId          String
  visiteur            Account         @relation("DemandesVisiteur", fields: [visiteurId], references: [id], onDelete: Restrict)
  prestataireId       String?
  prestataire         Account?        @relation("DemandesPrestataire", fields: [prestataireId], references: [id], onDelete: SetNull)

  genre               GenreOffreDb
  statut              StatutDemandeDb @default(envoyee)

  offreId             String?
  offreTitre          String
  offreVignette       String?

  dateDebut           String?
  dateFin             String?
  personnes           Int             @default(1)
  heureArrivee        String?
  lieuDepart          String?
  lieuArrivee         String?
  prestationTransport String?
  bagages             Int?
  vol                 String?
  message             String?

  /// Service à la demande : la clé du service, et la saisie du visiteur telle
  /// quelle. Sans cette colonne, un formulaire de service arrivait à l'équipe
  /// vidé de tout ce qui permettait de chercher.
  service             String?
  details             Json?

  /// Traitement interne, jamais montré au visiteur ni au partenaire.
  noteInterne         String?
  prixPropose         Int?

  prixUnitaire        Int             @default(0)
  nuits               Int?
  fraisFixes          Json?
  prixTotal           Int             @default(0)

  coordonnees         Json?
  frise               Json

  expireLe            DateTime?

  /// Quand l'équipe a été relancée sur cette demande, si elle l'a été.
  ///
  /// Le veilleur signale une demande qui approche de son échéance sans
  /// réponse. Cette colonne est ce qui l'empêche de la signaler toutes les
  /// cinq minutes : une alerte répétée se filtre, et une alerte filtrée ne
  /// prévient plus personne.
  relanceeLe          DateTime?
  motifRefus          String?

  creeLe              DateTime        @default(now())
  misAJourLe          DateTime        @updatedAt

  jetonsReponse       ProviderResponseToken[]

  @@index([visiteurId, statut])
  @@index([prestataireId, statut])
  @@index([reference])
  // Le backoffice liste par date d'envoi décroissante, filtrée par statut et
  // par genre : c'est la requête la plus fréquente de l'API d'administration.
  @@index([statut, creeLe])
  @@index([genre, creeLe])
  @@map("demands")
}

model ProviderResponseToken {
  id            String    @id @default(cuid())
  demandeId     String
  demande       Demand    @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  prestataireId String
  prestataire   Account   @relation(fields: [prestataireId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  reponse       String?
  motifRefus    String?
  creeLe        DateTime  @default(now())

  @@index([demandeId])
  @@index([prestataireId])
  @@index([tokenHash])
  @@map("provider_response_tokens")
}
