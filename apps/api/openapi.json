  "info": {
    "title": "Teranga Way — API",
    "description": "Logements et transports vérifiés pour les JOJ Dakar 2026. Aucune passerelle de paiement en ligne : un éventuel acompte est réglé par virement ou Mobile Money et vérifié manuellement par l'équipe.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "EnvoyerOtpDto": {
        "type": "object",
        "properties": {
          "identifiant": {
            "type": "string",
            "example": "visiteur@example.com",
            "description": "Adresse e-mail ou téléphone"
          },
          "email": {
            "type": "string",
            "example": "visiteur@example.com"
          },
          "telephone": {
            "type": "string",
            "example": "+221 77 000 00 00"
          }
        }
      },
      "VerifierOtpDto": {
        "type": "object",
        "properties": {
          "identifiant": {
            "type": "string",
            "example": "visiteur@example.com",
            "description": "Adresse e-mail ou téléphone"
          },
          "email": {
            "type": "string",
            "example": "visiteur@example.com"
          },
          "telephone": {
            "type": "string",
            "example": "+221 77 000 00 00"
          },
          "code": {
            "type": "string",
            "example": "123456",
            "description": "Code à 6 chiffres reçu"
          }
        },
        "required": [
          "code"
        ]
      },
      "InscriptionDto": {
        "type": "object",
        "properties": {
          "nom": {
            "type": "string",
            "example": "Rokhaya Seck"
          },
          "email": {
            "type": "string",
            "example": "rokhaya.seck@exemple.sn"
          },
          "motDePasse": {
            "type": "string",
            "example": "un mot de passe assez long",
            "description": "Dix caractères au minimum. Jamais journalisé, jamais renvoyé."
          }
        },
        "required": [
          "nom",
          "email",
          "motDePasse"
        ]
      },
      "VerifierInscriptionDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rokhaya.seck@exemple.sn"
          },
          "code": {
            "type": "string",
            "example": "481502",
            "description": "Code à six chiffres reçu par e-mail"
          }
        },
        "required": [
          "email",
          "code"
        ]
      },
      "RenvoyerCodeInscriptionDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rokhaya.seck@exemple.sn"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConnexionMotDePasseDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rokhaya.seck@exemple.sn"
          },
          "motDePasse": {
            "type": "string",
            "example": "un mot de passe assez long"
          }
        },
        "required": [
          "email",
          "motDePasse"
        ]
      },
      "OAuthGoogleDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rokhaya.seck@gmail.com",
            "description": "Adresse confirmée par Google."
          },
          "nom": {
            "type": "string",
            "example": "Rokhaya Seck",
            "description": "Nom affiché du compte Google."
          },
          "sub": {
            "type": "string",
            "example": "117240…",
            "description": "Identifiant Google stable de la personne. Journalisé, jamais affiché."
          }
        },
        "required": [
          "email"
        ]
      },
      "ConnexionPrestataireDto": {
        "type": "object",
        "properties": {
          "telephone": {
            "type": "string",
            "example": "+221 77 111 22 33"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "telephone",
          "code"
        ]
      },
      "ContactDemandeDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "visiteur@exemple.com"
          },
          "nom": {
            "type": "string",
            "example": "Rokhaya Seck"
          },
          "telephone": {
            "type": "string",
            "example": "+221 77 000 00 00"
          }
        },
        "required": [
          "email"
        ]
      },
      "CreerDemandeLogementDto": {
        "type": "object",
        "properties": {
          "logementId": {
            "type": "string",
            "example": "l-001"
          },
          "debut": {
            "type": "string",
            "example": "2026-10-12"
          },
          "fin": {
            "type": "string",
            "example": "2026-10-26"
          },
          "personnes": {
            "type": "number",
            "example": 2
          },
          "heureArrivee": {
            "type": "string",
            "example": "15:00"
          },
          "message": {
            "type": "string"
          },
          "contact": {
            "description": "Coordonnées du visiteur, quand aucune session n'est ouverte. Plus de code à saisir : l'adresse rattache la demande, elle ne vaut pas identité.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ContactDemandeDto"
              }
            ]
          }
        },
        "required": [
          "logementId",
          "debut",
          "fin",
          "personnes"
        ]
      },
      "CreerDemandeVehiculeDto": {
        "type": "object",
        "properties": {
          "vehiculeId": {
            "type": "string",
            "example": "v-001"
          },
          "prestation": {
            "type": "string",
            "enum": [
              "trajet",
              "journee",
              "taxi"
            ]
          },
          "depart": {
            "type": "string",
            "example": "Aéroport AIBD"
          },
          "arrivee": {
            "type": "string",
            "example": "Plateau"
          },
          "quand": {
            "type": "string",
            "example": "2026-10-12T10:00:00"
          },
          "passagers": {
            "type": "number",
            "example": 2
          },
          "bagages": {
            "type": "number",
            "example": 2
          },
          "vol": {
            "type": "string",
            "example": "SN 1234"
          },
          "message": {
            "type": "string"
          },
          "contact": {
            "description": "Coordonnées du visiteur, quand aucune session n'est ouverte. Plus de code à saisir : l'adresse rattache la demande, elle ne vaut pas identité.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ContactDemandeDto"
              }
            ]
          }
        },
        "required": [
          "vehiculeId",
          "prestation",
          "depart",
          "quand",
          "passagers",
          "bagages"
        ]
      },
      "CreerDemandeServiceDto": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "guides",
              "restauration",
              "assistance",
              "internet"
            ]
          },
          "details": {
            "type": "object",
            "description": "La saisie du visiteur, champ par champ.",
            "example": {
              "date": "2026-11-02",
              "personnes": "4",
              "besoin": "accueil-aeroport"
            }
          },
          "message": {
            "type": "string"
          },
          "contact": {
            "description": "Coordonnées du visiteur, quand aucune session n'est ouverte. Plus de code à saisir : l'adresse rattache la demande, elle ne vaut pas identité.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ContactDemandeDto"
              }
            ]
          }
        },
        "required": [
          "service",
          "details"
        ]
      },
      "RepondreDto": {
        "type": "object",
        "properties": {
          "reponse": {
            "type": "string",
            "enum": [
              "acceptee",
              "refusee",
              "indisponible"
            ]
          },
          "motif": {
            "type": "string",
            "enum": [
              "plus-disponible",
              "dates-impossibles",
              "capacite",
              "autre"
            ]
          }
        },
        "required": [
          "reponse"
        ]
      },
      "MettreAJourDemandeDto": {
        "type": "object",
        "properties": {
          "statut": {
            "type": "string",
            "enum": [
              "envoyee",
              "acceptee",
              "confirmee",
              "terminee",
              "refusee",
              "expiree",
              "annulee"
            ]
          },
          "motifRefus": {
            "type": "string",
            "enum": [
              "plus-disponible",
              "dates-impossibles",
              "capacite",
              "autre"
            ]
          },
          "prestataireId": {
            "type": "object",
            "nullable": true
          },
          "noteInterne": {
            "type": "string",
            "maxLength": 4000
          },
          "prixPropose": {
            "type": "object",
            "nullable": true,
            "description": "En francs CFA."
          }
        }
      }
    }
  }
}
