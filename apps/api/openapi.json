    "/vehicules/facettes": {
      "get": {
        "operationId": "ControleurVehicules_facettes",
        "summary": "Compteurs de filtres",
        "description": "Chaque compteur neutralise son propre filtre : cocher « SUV » ne doit pas faire tomber les autres catégories à zéro.",
        "parameters": [
          {
            "name": "besoin",
            "required": true,
            "in": "query",
            "description": "Le besoin détermine l'offre exigée du véhicule.",
            "schema": {
              "enum": [
                "trajet",
                "location",
                "taxi"
              ],
              "type": "string"
            }
          },
          {
            "name": "passagers",
            "required": false,
            "in": "query",
            "schema": {
              "example": 2,
              "type": "number"
            }
          },
          {
            "name": "bagages",
            "required": false,
            "in": "query",
            "schema": {
              "example": 2,
              "type": "number"
            }
          },
          {
            "name": "quand",
            "required": false,
            "in": "query",
            "description": "Prise en charge souhaitée. Un trajet demandé trop tôt est refusé (`DELAI_TROP_COURT`).",
            "schema": {
              "example": "2026-10-25T10:00",
              "type": "string"
            }
          },
          {
            "name": "categories",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "berline",
                  "suv",
                  "minibus",
                  "taxi"
                ]
              }
            }
          },
          {
            "name": "zone",
            "required": false,
            "in": "query",
            "schema": {
              "example": "Dakar",
              "type": "string"
            }
          },
          {
            "name": "prixMin",
            "required": false,
            "in": "query",
            "schema": {
              "example": 20000,
              "type": "number"
            }
          },
          {
            "name": "prixMax",
            "required": false,
            "in": "query",
            "schema": {
              "example": 100000,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "vehicules"
        ]
      }
    },
