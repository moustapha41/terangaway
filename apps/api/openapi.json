  "info": {
    "title": "Teranga Way — API",
    "description": "Logements et transports vérifiés pour les JOJ Dakar 2026. Aucun paiement en ligne : le paiement a lieu sur place.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "EnvoyerOtpDto": {
        "type": "object",
        "properties": {
          "telephone": {
            "type": "string",
            "example": "+221 77 000 00 00"
          }
        },
        "required": [
          "telephone"
        ]
      },
      "VerifierOtpDto": {
        "type": "object",
        "properties": {
          "telephone": {
            "type": "string",
            "example": "+221 77 000 00 00"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "telephone",
          "code"
        ]
      },
      "ConnexionPrestataireDto": {
        "type": "object",
        "properties": {
          "telephone": {
            "type": "string",
            "example": "+221 77 111 22 33"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "telephone",
          "code"
        ]
      },
      "CreerDemandeLogementDto": {
        "type": "object",
        "properties": {
          "logementId": {
            "type": "string",
            "example": "l-001"
          },
          "debut": {
            "type": "string",
            "example": "2026-10-12"
          },
          "fin": {
            "type": "string",
            "example": "2026-10-26"
          },
          "personnes": {
            "type": "number",
            "example": 2
          },
          "heureArrivee": {
            "type": "string",
            "example": "15:00"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Code OTP à six chiffres. Obligatoire tant qu'aucune session n'est active.",
            "example": "123456"
          }
        },
        "required": [
          "logementId",
          "debut",
          "fin",
          "personnes"
        ]
      },
      "CreerDemandeVehiculeDto": {
        "type": "object",
        "properties": {
          "vehiculeId": {
            "type": "string",
            "example": "v-001"
          },
          "prestation": {
            "type": "string",
            "enum": [
              "trajet",
              "journee",
              "taxi"
            ]
          },
          "depart": {
            "type": "string",
            "example": "Aéroport AIBD"
          },
          "arrivee": {
            "type": "string",
            "example": "Plateau"
          },
          "quand": {
            "type": "string",
            "example": "2026-10-12T10:00:00"
          },
          "passagers": {
            "type": "number",
            "example": 2
          },
          "bagages": {
            "type": "number",
            "example": 2
          },
          "vol": {
            "type": "string",
            "example": "SN 1234"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": [
          "vehiculeId",
          "prestation",
