    "/logements": {
      "get": {
        "operationId": "ControleurLogements_chercher",
        "summary": "Chercher des logements vérifiés",
        "description": "Les compteurs de filtres (`facettes`) portent sur la ville entière, pas sur le résultat filtré : c'est ce qui permet d'élargir sa recherche.",
        "parameters": [
          {
            "name": "ville",
            "required": false,
            "in": "query",
            "schema": {
              "example": "Dakar",
              "type": "string"
            }
          },
          {
            "name": "personnes",
            "required": false,
            "in": "query",
            "description": "Capacité minimale demandée.",
            "schema": {
              "example": 2,
              "type": "number"
            }
          },
          {
            "name": "types",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "villa",
                  "appartement",
                  "studio",
                  "chambre",
                  "residence"
                ]
              }
            }
          },
          {
            "name": "equipements",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "climatisation",
                  "wifi",
                  "eau-chaude",
                  "cuisine",
                  "groupe-electrogene",
                  "parking",
                  "gardien",
                  "piscine",
                  "tv",
                  "lave-linge",
                  "balcon-terrasse"
                ]
              }
            }
          },
          {
            "name": "quartiers",
            "required": false,
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "prixMin",
            "required": false,
            "in": "query",
            "schema": {
              "example": 50000,
              "type": "number"
            }
          },
          {
            "name": "prixMax",
            "required": false,
            "in": "query",
            "schema": {
              "example": 200000,
              "type": "number"
            }
          },
          {
            "name": "tri",
            "required": false,
            "in": "query",
            "schema": {
              "enum": [
                "pertinence",
                "prix-croissant",
                "prix-decroissant",
                "capacite",
                "note"
              ],
              "type": "string"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "example": 1,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": [
          "logements"
        ]
      }
    },
    "/logements/par-id/{id}": {
      "get": {
        "operationId": "ControleurLogements_parId",
        "summary": "Fiche d'un logement par identifiant",
        "description": "Utilisé là où le site ne connaît que l'identifiant — une demande, une réservation — et non le slug public.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "example": "l-004",
              "type": "string"
            }
          }
        ],
        "responses": {
          "404": {
            "description": "`LOGEMENT_INTROUVABLE`"
          }
        },
        "tags": [
          "logements"
        ]
      }
    },
