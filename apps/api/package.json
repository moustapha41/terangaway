{
  "name": "@teranga/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --exec \"node --import tsx\"",
    "build": "nest build",
    "start": "node --import tsx dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "nest build && node --import tsx dist/exporter-openapi.js",
    "verifier:depots": "node scripts/verifier-depots.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/swagger": "7.4.2",
    "@prisma/client": "5.21.1",
    "@teranga/contracts": "workspace:*",
    "@teranga/fixtures": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "tsx": "4.19.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.5",
    "@nestjs/testing": "10.4.4",
    "@types/express": "4.17.21",
    "@types/node": "22.7.4",
    "prisma": "5.21.1",
    "typescript": "5.6.2",
    "vitest": "2.1.2"
  }
}
