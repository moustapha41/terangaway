# ─── Général ────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_NAME="Teranga Way"            # nom retenu
APP_URL=http://localhost:3000
ADMIN_URL=http://localhost:3002
API_URL=http://localhost:3001
LANGUES=fr,en,es
LANGUE_DEFAUT=fr

# ─── Base de données ────────────────────────────────────────────────────────
DATABASE_URL=postgresql://teranga:teranga@localhost:5432/teranga?schema=public
# PostGIS requis pour la recherche par distance aux sites de compétition

# ─── Cache, sessions, file de notifications ─────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Stockage objet (photos des fiches) ─────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=teranga-photos
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=eu-west-1
S3_URL_PUBLIQUE=

# ─── Authentification ───────────────────────────────────────────────────────
JWT_SECRET=
SESSION_SECRET=
OTP_LONGUEUR=6
OTP_DUREE_MINUTES=5
OTP_ESSAIS_MAX=5
SESSION_VISITEUR_JOURS=30
SESSION_INTERNE_HEURES=8

# ─── Notifications ──────────────────────────────────────────────────────────
SMS_FOURNISSEUR=                  # agrégateur local
SMS_API_KEY=
SMS_EXPEDITEUR=
EMAIL_FOURNISSEUR=
EMAIL_API_KEY=
EMAIL_EXPEDITEUR=
WHATSAPP_NUMERO=                  # compte professionnel, seconde vague
PUSH_VAPID_PUBLIC=
PUSH_VAPID_PRIVATE=

# ─── Assistance ─────────────────────────────────────────────────────────────
NUMERO_ASSISTANCE=
WHATSAPP_ASSISTANCE=

# ─── Carte ──────────────────────────────────────────────────────────────────
MAPLIBRE_STYLE_URL=
TUILES_URL=

# ─── Traduction automatique ─────────────────────────────────────────────────
TRADUCTION_FOURNISSEUR=
TRADUCTION_API_KEY=

# ─── Liens partenaires (liste blanche stricte, cf. §11 sécurité) ────────────
DOMAINES_REDIRECTION_AUTORISES=yango.com,yassirapp.com

# ─── Développement frontend d'abord ─────────────────────────────────────────
NEXT_PUBLIC_API_MOCK=true         # false = écriture (comptes/demandes/reponses/visiteurs) via l'API
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Interrupteurs de fonctionnalités ───────────────────────────────────────
FF_ESPACE_PRESTATAIRE=true        # espace prestataire avec compte — DANS la V1
FF_LOCATION_SANS_CHAUFFEUR=false  # TRA-21..24, reporté après MVP
FF_TAXI_MULTI_DIFFUSION=false     # TRA-32, envoi automatique à plusieurs taxis
FF_CARTE_RESULTATS=false          # LOG-08
FF_TRI_PAR_DISTANCE_SITE=false    # LOG-07
