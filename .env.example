# ==============================================================================
# FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT — TERANGA WAY (PRODUCTION & DEV)
# ==============================================================================
#
# IMPORTANT :
# - Ce fichier recense UNIQUEMENT les variables réellement lues et utilisées
#   par le code source (Next.js 15, NestJS 10, Prisma ORM).
# - Ne jamais inscrire de vrais secrets ou mots de passe ici.
# - Distinguer les variables de compilation (injectées lors du build Docker)
#   des variables d'exécution (lues au démarrage des conteneurs).
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DONNÉES (PostgreSQL 16 & Prisma)
# ------------------------------------------------------------------------------

# Identifiants du conteneur PostgreSQL (utilisés par le service docker-compose)
POSTGRES_USER=teranga
POSTGRES_PASSWORD=changer_ce_mot_de_passe_en_production
POSTGRES_DB=teranga

# Chaîne de connexion PostgreSQL utilisée par Prisma ORM (@teranga/api)
# Format : postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# En réseau Docker interne : host = postgres, port = 5432
DATABASE_URL=postgresql://teranga:changer_ce_mot_de_passe_en_production@postgres:5432/teranga?schema=public

# --- BASE DE TEST (tests d'intégration uniquement) ---
#
# VIDE ICI, ET ELLE DOIT LE RESTER. Cette variable se pose dans le shell de la
# personne, ou dans un `apps/api/.env.test` (non suivi par Git) — jamais dans ce
# fichier d'exemple, qui est public.
#
# Elle est lue UNIQUEMENT par `pnpm -F @teranga/api test:integration`. Absente,
# la suite d'intégration ne démarre pas : elle ne se rabat jamais sur
# DATABASE_URL ni sur apps/api/.env — ce serait écrire dans la base de
# développement, ce qu'elle faisait avant ce garde-fou.
#
# Le nom de la base doit être « teranga_test » AU CARACTÈRE PRÈS. Un nom qui se
# termine par « _test » ne suffit pas : une coquille en porte un aussi. Et si
# DATABASE_URL désigne la même base, la suite refuse également de démarrer.
#
# Format : postgresql://<utilisateur>:<secret>@<hôte>:<port>/teranga_test?schema=public
#
# La base n'existe pas encore. Pour la créer et y appliquer les migrations :
#   docs/05-exploitation/runbooks/base-de-test-postgres.md
#
# ATTENTION : `prisma migrate deploy` lit DATABASE_URL, pas celle-ci, et le CLI
# charge apps/api/.env. La surcharge explicite est obligatoire, sans quoi la
# commande viserait la base de développement :
#   DATABASE_URL="$DATABASE_URL_TEST" pnpm -F @teranga/api exec prisma migrate deploy
DATABASE_URL_TEST=

# ------------------------------------------------------------------------------
# 2. ENVIRONNEMENT GÉNÉRAL D'EXÉCUTION
# ------------------------------------------------------------------------------

# Environnement Node.js ('production' sur Dokploy, 'development' en local)
# Active notamment la sécurité HTTPS stricte des cookies (Secure: true)
NODE_ENV=production

# Désactivation de la télémétrie Next.js pour accélérer les builds et protéger la vie privée
NEXT_TELEMETRY_DISABLED=1

# ------------------------------------------------------------------------------
# 3. BACKEND API (@teranga/api - NestJS 10)
# ------------------------------------------------------------------------------

# Port d'écoute interne du serveur NestJS (exposé dans le conteneur)
# En production Dokploy : 3101 (pour ne pas interférer avec le port 3000 de Dokploy)
PORT=3101

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# Doit inclure l'URL publique complète du frontend HTTPS.
# Exemple en production : https://terangaway.sn,https://www.terangaway.sn
# Exemple en développement : http://localhost:3100,http://localhost:3000
ORIGINES_AUTORISEES=http://localhost:3100

# Paramètres métier et délais de réponse :
# Durée de validité d'un jeton SMS de réponse partenaire, en minutes (PAR-11)
DUREE_JETON_MINUTES=120

# Délai maximum accordé au partenaire pour accepter/refuser une demande, en minutes
DELAI_REPONSE_MINUTES=120

# Préavis minimal imposé avant la prise en charge d'un transport/logement, en heures
DELAI_MINIMUM_HEURES=2

# Configuration Resend (e-mails transactionnels & codes OTP)
# OBLIGATOIRE en production Dokploy (ne jamais inscrire de vraie clé dans Git !)
RESEND_API_KEY=re_votre_cle_api_resend_ici

# Expéditeur d'e-mails (doit utiliser un domaine vérifié dans le dashboard Resend)
# Exemple production : Teranga Way <auth@teranga-way.com>
# Exemple test / staging : Teranga Way <onboarding@resend.dev>
EMAIL_FROM=Teranga Way <auth@teranga-way.com>

# URL publique de l'application Web (utilisée pour les liens dans les e-mails)
# Exemple production : https://teranga-way.com
APP_URL=https://teranga-way.com

# Clé secrète dédiée pour le hachage HMAC-SHA-256 des codes OTP (exclusive à l'API)
# OBLIGATOIRE en production (au moins 32 caractères aléatoires, ne jamais la partager ou l'exposer)
# Supporte plusieurs clés séparées par des virgules pour rotation sans coupure
OTP_SECRET=cle_secrete_aleatoire_tres_longue_et_robuste_pour_hmac_otp

# Les adresses qui ouvrent le backoffice (/admin), séparées par des virgules.
#
# Vide par défaut : sans cette variable, aucun compte n'est administrateur et
# la porte reste fermée. `pnpm db:seed` promeut ces adresses au rôle
# ADMINISTRATEUR ; en base, c'est le rôle du compte qui fait foi, cette liste
# ne sert qu'au dépôt en mémoire.
ADMIN_EMAILS=

# Clé précédente optionnelle lors d'une rotation de secret OTP
# OTP_PREVIOUS_SECRET=ancienne_cle_secrete_pendant_periode_transition

# ------------------------------------------------------------------------------
# 3bis. ACOMPTE PAR PAIEMENT MANUEL (fermé par défaut)
# ------------------------------------------------------------------------------
#
# Paiement MANUEL : aucune passerelle, aucune API de paiement, aucun webhook.
# Le client règle par virement, Wave ou Orange Money ; une personne de l'équipe
# vérifie la réception sur le compte et la constate depuis le backoffice.
# Rien n'est considéré comme reçu avant ce constat.
#
# Toutes les variables ci-dessous sont lues dans apps/api/src/config/configuration.ts
# (fonction chargerAcompte), au démarrage de l'API. Une valeur vide équivaut à une
# variable absente.
#
# L'acompte est à REFUS PAR DÉFAUT. Pour qu'il soit réellement ouvert, TOUT ceci
# doit être vrai en même temps :
#   1. ACOMPTE_ACTIF vaut exactement 'true' ;
#   2. ACOMPTE_POURCENTAGE est un taux valide ;
#   3. ACOMPTE_MOYENS ne contient que des moyens connus (ou est absente) ;
#   4. CHAQUE moyen accepté est complètement configuré (voir ci-dessous) ;
#   5. ACOMPTE_INSTRUCTIONS, si elle est posée, ne dépasse pas 500 caractères.
#
# Comportement au démarrage :
#   - ACOMPTE_ACTIF absent ou différent de 'true' : l'acompte reste fermé et
#     l'API démarre, QUEL QUE SOIT l'état des autres variables (même mal
#     renseignées : elles sont alors ignorées sans erreur).
#   - ACOMPTE_ACTIF=true mais une condition ci-dessus n'est pas remplie : l'API
#     REFUSE DE DÉMARRER en nommant ce qui manque, plutôt que de se taire et de
#     ne jamais rien réclamer.
# Vérification à chaud : GET /sante/posture sur l'API. Elle dit si l'acompte est
# actif, le taux, les délais par genre et l'état « defini | incomplet | absent »
# des coordonnées bancaires — jamais une coordonnée. (Elle ne détaille pas les
# moyens Mobile Money.)
#
# Le verrou juridique. Tant qu'il ne vaut pas exactement 'true' (casse et
# espaces ignorés), AUCUN montant ne peut être réclamé à personne.
# À NE PASSER À 'true' QU'APRÈS LA VALIDATION JURIDIQUE : encaisser des
# acomptes change la nature de l'activité (CGV, mentions légales, facturation).
ACOMPTE_ACTIF=false

# Taux de l'acompte, en pourcents ENTIERS de 1 à 100 ("30" : oui ; "30.5", "0",
# "101", "abc" : non). Obligatoire dès que ACOMPTE_ACTIF=true.
# Le montant est calculé côté serveur à partir du prix figé de la demande, en
# francs CFA entiers, arrondi au franc le plus proche (Math.round). Le taux est
# figé sur chaque dossier à sa création : le modifier plus tard ne réécrit pas
# les acomptes déjà demandés.
# Valeur retenue (décision produit provisoire) : 30 % du prix confirmé.
ACOMPTE_POURCENTAGE=30

# Les moyens de paiement acceptés, séparés par des virgules : virement, wave,
# orange-money. Casse et espaces ignorés, doublons ignorés.
#   - FACULTATIVE. Absente, ou vide : le virement seul (comportement historique).
#   - Une valeur inconnue (ex. "carte") ou une liste sans aucun moyen fait refuser
#     le démarrage quand ACOMPTE_ACTIF=true. Elle n'est jamais ignorée en silence.
#   - Un moyen NON listé ici n'est ni proposé ni exigé, même si ses variables
#     sont renseignées.
#   - Chaque moyen listé doit être complet, sinon le démarrage est refusé :
#       virement      -> les QUATRE variables ACOMPTE_BANQUE_* ci-dessous ;
#       wave          -> ACOMPTE_WAVE_NUMERO ET ACOMPTE_WAVE_TITULAIRE ;
#       orange-money  -> ACOMPTE_ORANGE_MONEY_NUMERO ET ACOMPTE_ORANGE_MONEY_TITULAIRE.
#   - Mobile Money seul est possible (sans coordonnées bancaires) :
#     ACOMPTE_MOYENS=wave
# Exemple (à décommenter seulement pour proposer plusieurs moyens) :
# ACOMPTE_MOYENS=virement,wave,orange-money

# Le DÉLAI de paiement n'est pas une variable d'environnement, volontairement.
#
# Il dépend du genre de la demande, et il est indissociable de l'éligibilité :
#   logement  12 heures      location  12 heures (avec chauffeur)
#   trajet    aucun acompte  taxi      aucun acompte      service  aucun acompte
#
# Ces valeurs vivent dans `DELAIS_ACOMPTE_HEURES`
# (apps/api/src/modules/acomptes/calcul.ts), comme les délais de réponse vivent
# dans machine-a-etats/delais.ts. Une variable unique a existé ici
# (ACOMPTE_DELAI_HEURES) : elle imposait silencieusement les douze heures du
# logement à tous les genres, sans que chacun puisse changer. Elle est retirée et IGNORÉE si
# elle est posée. Ne pas la réintroduire.
#
# Le délai est compté DEPUIS L'ACCEPTATION par le partenaire — jamais depuis
# l'envoi — et il est plafonné par l'expiration de la demande.

# --- Virement bancaire (moyen "virement") ------------------------------------
# Le compte central de Teranga Way qui reçoit les acomptes.
#
# VIDES ICI, ET ILS DOIVENT LE RESTER. Aucune coordonnée bancaire réelle ne
# figure dans ce dépôt. Elles se renseignent uniquement dans l'onglet
# Environment de Dokploy, par une personne autorisée.
#
# Obligatoires si (et seulement si) "virement" est un moyen accepté — ce qui est
# le cas par défaut. Les QUATRE champs sont requis : un IBAN sans BIC, c'est un
# virement international qui n'arrive pas, et un visiteur qui croit avoir payé.
# Renseignés à moitié, ils ne sont pas exposés du tout.
#   ACOMPTE_BANQUE_TITULAIRE  nom du titulaire, tel que la banque l'attend (texte libre).
#   ACOMPTE_BANQUE_NOM        nom de l'établissement (texte libre).
#   ACOMPTE_BANQUE_IBAN       15 à 34 caractères alphanumériques ; espaces retirés
#                             et majuscules appliquées automatiquement. Contrôle de
#                             FORME seulement : la clé de contrôle n'est pas vérifiée.
#   ACOMPTE_BANQUE_BIC        texte libre, requis ; espaces retirés, majuscules.
#                             Aucun contrôle de format.
#
# ATTENTION : quiconque modifie ces quatre valeurs détourne tous les virements
# à venir. Tout changement doit être tracé et vérifié par un second regard.
ACOMPTE_BANQUE_TITULAIRE=
ACOMPTE_BANQUE_NOM=
ACOMPTE_BANQUE_IBAN=
ACOMPTE_BANQUE_BIC=

# --- Mobile Money (moyens "wave" et "orange-money") --------------------------
# Un compte par opérateur, avec exactement deux variables. VIDES ICI, ET ELLES
# DOIVENT LE RESTER : aucun numéro réel dans ce dépôt, seulement dans Dokploy.
#
# Obligatoires seulement si l'opérateur figure dans ACOMPTE_MOYENS ; alors les
# DEUX variables de l'opérateur sont requises ensemble. Un compte incomplet n'est
# jamais exposé dans un e-mail ni dans le backoffice.
#   *_NUMERO     8 à 15 chiffres, avec « + » initial facultatif (ex. forme
#                « +221XXXXXXXXX », à remplacer par le vrai numéro dans Dokploy).
#                Espaces, points, tirets et parenthèses sont retirés avant le
#                contrôle. Le contrôle est de FORME : l'existence du numéro n'est
#                pas vérifiée.
#   *_TITULAIRE  nom du bénéficiaire tel que l'opérateur l'affiche au payeur
#                (texte libre).
ACOMPTE_WAVE_NUMERO=
ACOMPTE_WAVE_TITULAIRE=
ACOMPTE_ORANGE_MONEY_NUMERO=
ACOMPTE_ORANGE_MONEY_TITULAIRE=

# --- Consignes libres ---------------------------------------------------------
# Texte facultatif ajouté à l'e-mail d'instructions de paiement (par exemple
# « Indiquez la référence de votre demande en message »). 500 caractères au plus ;
# au-delà, le démarrage est refusé quand ACOMPTE_ACTIF=true (et le texte est
# ignoré sinon). N'y mettre ni coordonnée de paiement ni secret : il est envoyé
# tel quel aux clients. Absente : aucune consigne ajoutée.
# Exemple (à décommenter si besoin) :
# ACOMPTE_INSTRUCTIONS=

# ------------------------------------------------------------------------------
# 4. FRONTEND (@teranga/web - Next.js 15)
# ------------------------------------------------------------------------------

# Port d'écoute du serveur Next.js en production (port 3100)
PORT_WEB=3100
HOSTNAME=0.0.0.0

# URL interne du backend API (utilisée côté serveur Next.js pour SSR et Server Actions)
# En production Docker Compose : utilise l'alias DNS 'api-interne' sur le réseau privé 'interne'
# pour éviter toute collision avec d'autres services nommés 'api' sur 'dokploy-network'.
API_URL=http://api-interne:3101

# Raccourcis de démonstration de l'API (compte `visiteur-demo`, code OTP fixe,
# code renvoyé dans la réponse HTTP, session résolue depuis un identifiant de
# compte). Ils sont à REFUS PAR DÉFAUT et n'existent que si cette variable vaut
# exactement 'true' ET que NODE_ENV n'est pas 'production'.
#
# À NE JAMAIS RENSEIGNER SUR UN DÉPLOIEMENT PUBLIC : ouvrir ces accès revient à
# distribuer une session à qui la demande, et à renvoyer le code OTP de
# n'importe quelle adresse dans la réponse.
#
# Pour un essai local, elle est déjà posée dans docker-compose.dev.yml.
# Vérification à chaud : GET /sante/posture sur l'API.
# AUTORISER_COMPTES_DEMO=true

# --- VARIABLES DE COMPILATION (BUILD-TIME NEXT.JS) ---
# ATTENTION : Les variables préfixées par NEXT_PUBLIC_ sont inlinées dans le bundle
# JavaScript navigateur lors de la commande `next build`.
# Toute modification de ces valeurs nécessite une reconstruction de l'image Docker.

# Mode de bouchonnage (fixtures) vs API réelle :
# - 'false' : Utilisation de la persistance réelle PostgreSQL / Prisma via l'API NestJS.
# - 'true'  : Utilisation des jeux d'essai statiques en mémoire (fixtures).
NEXT_PUBLIC_API_MOCK=false

# URL publique de l'API appelée directement par le navigateur client si l'API
# dispose d'un sous-domaine public dédié (ex: https://api.terangaway.sn).
# Si les requêtes passent par le serveur Next.js (SSR / proxy), cette variable peut être laissée vide.
NEXT_PUBLIC_API_URL=

# ------------------------------------------------------------------------------
# 5. PARAMÈTRES DE COOKIES ET SESSIONS (RÉSUMÉ ARCHITECTURE)
# ------------------------------------------------------------------------------
# Les cookies sont gérés par le code applicatif avec les caractéristiques suivantes :
# - Cookie Visiteur      : nom 'teranga_visiteur', durée 8 heures (28800 s), HttpOnly, Lax, Secure en prod
# - Cookie Prestataire   : nom 'teranga_prestataire', durée 8 heures (28800 s), HttpOnly, Lax, Secure en prod
# Aucune variable d'environnement secrète supplémentaire n'est requise pour ces cookies.
\n
# --- MESURE D'AUDIENCE (UMAMI) ---
# Secret de signature des sessions du tableau de bord. Obligatoire.
#   openssl rand -hex 32
UMAMI_APP_SECRET=

# Nom du FICHIER de script servi aux visiteurs — pas un domaine.
# « mesure » donne https://stats.exemple.com/mesure.js ; « script.js », le nom
# par défaut d'Umami, est reconnu par les bloqueurs de publicité, qui mangent
# 15 à 30 % du comptage. La même valeur est lue par le conteneur Umami et par
# le site : une seule variable, pour qu'elles ne puissent pas diverger.
UMAMI_TRACKER_SCRIPT_NAME=mesure

# Adresse publique du tableau de bord Umami, et identifiant du site qu'il
# affiche une fois créé dans son interface. Les deux sont lus par le serveur
# Next à chaque requête : sans eux, aucun script de mesure n'est posé.
UMAMI_URL=
UMAMI_SITE_ID=

# --- CLOUDFLARE ---
# À n'ouvrir qu'une fois le pare-feu du VPS restreint aux plages d'adresses de
# Cloudflare (https://www.cloudflare.com/ips/). L'API retient alors
# `CF-Connecting-IP` comme adresse du visiteur ; sans ce filtrage réseau,
# n'importe qui peut inventer cet en-tête en frappant l'IP du serveur et
# échapper ainsi à la limitation des codes.
DERRIERE_CLOUDFLARE=false
