<div class="section">
  <div class="container container--narrow">
    <div class="card text-center stack stack--md" style="justify-items: center; max-width: 28rem; margin-inline: auto;">
      <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="71" height="64">
      <h1 class="card__title" style="font-size: 24px;">{{ shop.name }}</h1>
      <p class="empty-state__text">{{ 'password.subtitle' | t }}</p>

      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="stack stack--md" style="width: 100%;">
          <div class="field">
            <label class="field__label" for="StorefrontPassword">{{ 'password.label' | t }}</label>
            <input class="field__input" id="StorefrontPassword" type="password" name="password" required>
          </div>
          <button type="submit" class="btn btn--primary btn--full btn--lg">{{ 'password.submit' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
