<div class="section">
  <div class="container container--narrow">
    {%- assign heading = 'customer.reset_password' | t -%}
    {% render 'section-heading', title: heading %}

    <div class="card" style="max-width: 28rem; margin-inline: auto;">
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="stack stack--md">
          <div class="field">
            <label class="field__label" for="ResetPassword">{{ 'customer.new_password' | t }}</label>
            <input class="field__input" id="ResetPassword" type="password" name="customer[password]" required autocomplete="new-password">
          </div>
          <div class="field">
            <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.confirm_password' | t }}</label>
            <input class="field__input" id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" required autocomplete="new-password">
          </div>
          <button type="submit" class="btn btn--primary btn--full btn--lg">{{ 'customer.reset_password' | t }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>
