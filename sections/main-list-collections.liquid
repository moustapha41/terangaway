{%- comment -%}
  Toutes les collections — grille de blocs.
  C'est la page sur laquelle pointe l'entrée « Collection » du menu.
{%- endcomment -%}

<div class="page-hero">
  <div class="container container--wide">
    <div class="page-hero__inner">
      {%- if section.settings.eyebrow != blank -%}
        <span class="page-hero__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="page-hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {% render 'ornament' %}

      {%- if section.settings.text != blank -%}
        <p class="page-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

<div class="section" style="padding-block: 56px 80px;">
  <div class="container container--wide">
    {%- liquid
      assign shown = 0
      assign hidden_handles = section.settings.hidden_handles | downcase | replace: ' ', '' | split: ','
    -%}

    <div class="collection-blocks">
      {%- for collection in collections -%}
        {%- liquid
          assign skip = false
          if section.settings.hide_empty and collection.all_products_count == 0
            assign skip = true
          endif
          if hidden_handles contains collection.handle
            assign skip = true
          endif
        -%}

        {%- unless skip -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign img_alt = collection.title | escape -%}

          <a class="collection-block" href="{{ collection.url }}">
            <div class="collection-block__media">
              {%- if collection.featured_image -%}
                {{
                  collection.featured_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(max-width: 759px) 100vw, 50vw',
                    alt: img_alt,
                    loading: 'lazy'
                }}
              {%- elsif collection.products.first.featured_media -%}
                {%- comment -%} Pas d'image de collection : on prend celle du premier produit {%- endcomment -%}
                {{
                  collection.products.first.featured_media
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(max-width: 759px) 100vw, 50vw',
                    alt: img_alt,
                    loading: 'lazy'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>

            <span class="collection-block__frame"></span>

            <div class="collection-block__body">
              <h2 class="collection-block__name">{{ collection.title }}</h2>
              <span class="collection-block__rule"></span>

              {%- if section.settings.show_count -%}
                <span class="collection-block__count">
                  {{ 'collections.product_count' | t: count: collection.all_products_count }}
                </span>
              {%- endif -%}

              <span class="collection-block__cta">
                {{ section.settings.cta_label }}
                {% render 'icon', name: 'arrow-right', size: 14, stroke: 1.6 %}
              </span>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>

    {%- if shown == 0 -%}
      <div class="collection-empty">
        {% render 'icon', name: 'gem', size: 40 %}
        <h2 class="collection-empty__title">{{ 'collections.none_title' | t }}</h2>
        <p class="collection-empty__text">{{ 'collections.none_text' | t }}</p>
        <a class="btn btn--primary btn--pill" href="{{ routes.all_products_collection_url }}">
          {{ 'collections.all' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Toutes les collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "NOS UNIVERS" },
    { "type": "text", "id": "title", "label": "Titre", "default": "Nos collections" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte d'introduction",
      "default": "Colliers, bracelets, bagues et boucles d'oreilles : chaque univers réunit des pièces choisies pour s'accorder à votre style."
    },
    { "type": "text", "id": "cta_label", "label": "Libellé au survol d'un bloc", "default": "Découvrir" },
    { "type": "checkbox", "id": "show_count", "label": "Afficher le nombre de produits", "default": true },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Masquer les collections vides",
      "default": true
    },
    {
      "type": "text",
      "id": "hidden_handles",
      "label": "Collections à masquer",
      "info": "Identifiants séparés par des virgules, par exemple : frontpage, nos-bijoux",
      "default": "frontpage"
    }
  ]
}
{% endschema %}
