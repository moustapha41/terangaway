{%- comment -%}
  Tiroir panier — reprise de src/components/cart/CartDrawer.tsx
  Le contenu est rendu par theme.js depuis /cart.js
{%- endcomment -%}

<div class="drawer drawer--cart" id="cart-drawer" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>

  <div class="drawer__panel">
    <div class="drawer__header">
      <h2 class="drawer__title">
        {% render 'icon', name: 'shopping-bag', size: 20 %}
        {{ 'cart.title' | t }} (<span data-cart-drawer-count>{{ cart.item_count }}</span>)
      </h2>

      <button type="button" class="drawer__close" data-drawer-close aria-label="{{ 'cart.close' | t }}">
        {% render 'icon', name: 'x', size: 20 %}
      </button>
    </div>

    <div class="drawer__body" data-cart-drawer-body></div>

    <template data-cart-empty-template>
      <div class="empty-state" style="border: 0; box-shadow: none; padding: 48px 0;">
        {% render 'icon', name: 'shopping-bag', size: 48 %}
        <p class="empty-state__text">{{ 'cart.empty' | t }}</p>
        <a class="btn btn--outline" href="{{ routes.all_products_collection_url }}" data-drawer-close>
          {{ 'cart.continue_shopping' | t }}
        </a>
      </div>
    </template>

    <div class="drawer__footer" data-cart-drawer-footer {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="cart-summary__total" style="border: 0; padding: 0;">
        <span>{{ 'cart.subtotal' | t }}</span>
        <span data-cart-drawer-subtotal>{{ cart.items_subtotal_price | money }}</span>
      </div>

      <p style="font-size: 12px; color: var(--muted);">{{ 'cart.shipping_note' | t }}</p>

      {% render 'cod-button' %}

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
        <a class="btn btn--outline btn--full" href="{{ routes.cart_url }}">{{ 'cart.view_cart' | t }}</a>
        {%- unless settings.cod_enabled and settings.cod_hide_checkout -%}
          <form action="{{ routes.cart_url }}" method="post">
            <button type="submit" name="checkout" class="btn btn--primary btn--full">
              {{ 'cart.checkout' | t }}
              {% render 'icon', name: 'arrow-right', size: 16 %}
            </button>
          </form>
        {%- endunless -%}
      </div>
    </div>
  </div>
</div>
