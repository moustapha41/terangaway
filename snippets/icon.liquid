{%- comment -%}
  Jeu d'icônes du thème (traits repris de lucide-react).
  Usage : {% render 'icon', name: 'shopping-bag', size: 16 %}
{%- endcomment -%}

{%- liquid
  assign size = size | default: 16
  assign stroke = stroke | default: 2
-%}

{%- case name -%}

  {%- when 'menu' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>

  {%- when 'x' -%}
    <svg class="icon" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>

